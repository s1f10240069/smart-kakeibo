{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smart-kakeibo",
  "compatibility_date": "2026-09-15",
  "keep_vars": true,
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/auth/*"]
  }
}
